# GENERATED by './webmail.sh install'. Do NOT commit credentials.
SECRET_KEY=REPLACED_BY_INSTALLER
SUBNET=192.168.203.0/24
DOMAIN=example.nl
HOSTNAMES=mailhome.example.nl
POSTMASTER=r
TLS_FLAVOR=cert
ADMIN=true
WEBMAIL=none
API=false
WEBDAV=none
ANTIVIRUS=none
SCAN_MACROS=false
MESSAGE_SIZE_LIMIT=50000000
MESSAGE_RATELIMIT=200/day
RELAYNETS=
RELAYHOST=[smtp.strato.de]:587
RELAYUSER=r@example.nl
RELAYPASSWORD=
OUTBOUND_TLS_LEVEL=encrypt
FETCHMAIL_ENABLED=True
FETCHMAIL_DELAY=300
RECIPIENT_DELIMITER=+
DMARC_RUA=r
DMARC_RUF=r
WELCOME=false
COMPRESSION=
FULL_TEXT_SEARCH=en
WEBROOT_REDIRECT=/admin
WEB_ADMIN=/admin
WEB_WEBMAIL=
WEB_API=/api
SITENAME=GZ0 Mail
WEBSITE=https://mailhome.example.nl
COMPOSE_PROJECT_NAME=webmail
CREDENTIAL_ROUNDS=12
REAL_IP_HEADER=
REAL_IP_FROM=
REJECT_UNLISTED_RECIPIENT=yes
LOG_LEVEL=INFO
TZ=Europe/Amsterdam
DEFAULT_SPAM_THRESHOLD=100
# This grants r@example.nl broad sender-spoofing rights within Mailu.
# Do not enable for any other mailbox without understanding the consequences.
WILDCARD_SENDERS=r@example.nl
PORTS=25,80,443,465,587,143,993,4190
DISABLE_STATISTICS=True
