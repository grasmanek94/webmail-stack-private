# Copy this file to backup.env (chmod 600) when ready to configure backups.
# Create SSH key and a restricted, dedicated backup account on the main server.
# Change both values to your actual destination.
RESTIC_REPOSITORY=sftp:mailbackup@MAIN-SERVER:/srv/backups/webmail-restic
# This password file is stored on the Raspberry Pi, outside the backed-up folders.
RESTIC_PASSWORD_FILE=/root/.config/webmail/restic-password
