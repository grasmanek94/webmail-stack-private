# Container tags: Mailu stable series is 2024.06. Use './webmail.sh update' for patches.
MAILU_VERSION=2024.06
ROUNDCUBE_VERSION=latest
# Automatically generated on install/prepare. Do not rotate casually.
ROUNDCUBE_DES_KEY=
# Roundcube single-file upload cap; use ./webmail.sh attachments 30.
ROUNDCUBE_UPLOAD_LIMIT=30M

# Main host settings. Keep these values as-is initially if you like.
# Raspberry Pi default. Change with ./webmail.sh configure /mnt/ssd/webmail BEFORE install.
DATA_ROOT=/srv/webmail
OWNER_USER=root
OWNER_GROUP=root
# Optional: if using a removable/SSD mount, insist it is mounted before startup.
# Example: DATA_DISK_MOUNT=/mnt/ssd
DATA_DISK_MOUNT=
MAIL_DOMAIN=example.com
LOCAL_MAILBOX=test@example.com
MAIL_HOSTNAME=mailhome.example.com
# Add your actual LAN IPv4 to the self-signed cert at installation.
LAN_IP=127.0.0.1
BIND_IP=0.0.0.0

# Host ports. TCP/25 deliberately NOT exposed; MX remains at STRATO.
WEB_HTTPS_PORT=443
WEB_HTTP_PORT=8080
ADMIN_HTTPS_PORT=8443
IMAPS_PORT=993
SMTPS_PORT=465
SUBMISSION_PORT=587
SIEVE_PORT=4190

# Change these only if the Docker subnet conflicts with your network.
MAILU_SUBNET=192.168.203.0/24
RESOLVER_IP=192.168.203.254
